# Backend Server Configuration
HOST=0.0.0.0
PORT=5002
LOG_LEVEL=INFO
# Comma-separated list, "*" only for development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ROS2 Configuration
ROS_DOMAIN_ID=0

# Frontend Configuration
# Optional - automatically matches backend PORT if not set
VITE_API_PORT=5002
VITE_DEV_PORT=5173
VITE_CESIUM_ION_TOKEN=your_cesium_ion_token_here